{
  "name": "magnate-liveops",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Magnate LiveOps - real-time marine operations visibility platform",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.ts",
    "build": "vite build && npm run build:api",
    "build:api": "esbuild server/app.ts --bundle --platform=node --target=node22 --format=esm --outfile=server-dist/app.mjs --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\"",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "express": "^5.3.0",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
